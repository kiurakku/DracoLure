# Copy to .env and adjust for local overrides (optional — defaults work for dev).
POSTGRES_DB=honeypot
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=honeypot_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Detection / quarantine tuning (optional) ---
# HONEYPOT_BLOCK_THRESHOLD=100
# HONEYPOT_WINDOW_SECONDS=300
# HONEYPOT_BLOCK_TTL=600
# HONEYPOT_TARPIT_SECONDS=1.5

# --- Integration API (optional) ---
# When set, every /api/v1 request must send the X-API-Key header.
# DRACOLURE_API_KEY=change-me
